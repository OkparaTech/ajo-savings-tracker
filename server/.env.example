# PostgreSQL. Use a least-privilege runtime role; use a separate migration role.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Public origin without a path. Required HTTPS in production.
APP_URL=http://localhost:8080
PORT=8080
NODE_ENV=development
# Set only to the exact number of trusted ingress proxies in your deployment.
# Direct local server: 0. Verify platform ingress behavior before changing this.
TRUST_PROXY_HOPS=0
# Start with TEST keys. Never commit real credentials.
PAYSTACK_SECRET_KEY=sk_test_replace_me
# SMTP is optional with Paystack TEST keys for previews, including NODE_ENV=production.
# Without it, verification, password recovery and reminders are unavailable.
# Configure SMTP before switching to LIVE payments.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Ajo <noreply@example.com>"
# Disposable test database only. It must end in _test.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/ajo_test
