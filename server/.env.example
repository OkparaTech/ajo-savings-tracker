# Copy this file to .env and fill in real values. Never commit .env itself.

# Your Neon connection string — from the Neon dashboard: Connection Details
# → "Pooled connection" string. It looks like:
# postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Any long random string — used to sign login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Optional — Express defaults to 8080 locally; Render sets this automatically.
PORT=8080

# Set to "production" when deployed so auth cookies require HTTPS.
NODE_ENV=development

# From your Paystack dashboard → Settings → API Keys & Webhooks.
# Use the TEST keys while developing — switch to LIVE keys only once your
# Paystack business account is fully verified for real payouts.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# The public URL of this app — used to build the Paystack payment callback.
# Locally this is fine as-is; in production, set it to your Render URL,
# e.g. https://ajo-savings-tracker.onrender.com
APP_URL=http://localhost:8080
